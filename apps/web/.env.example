# =============================================================================
# CommitAI web app — environment
# Copy to `apps/web/.env` (gitignored) and fill in. Never commit real secrets.
# =============================================================================

# PostgreSQL connection string used by Prisma (datasource `db` in
# prisma/schema.prisma).
#
# Offline Prisma commands work with any syntactically valid URL:
#   pnpm --filter web exec prisma validate
#   pnpm --filter web exec prisma generate
#   pnpm --filter web exec prisma migrate diff \
#     --from-empty --to-schema-datamodel prisma/schema.prisma --script
#
# APPLYING migrations (`prisma migrate deploy`) and the DB-gated integration
# tests need a REACHABLE Postgres: a local install, a managed instance, or a
# container. When DATABASE_URL is unset/unreachable those tests skip cleanly
# (see LIMITATIONS.md step 3); the unit tests never need a DB.
DATABASE_URL="postgresql://user:password@localhost:5432/commitai?schema=public"
