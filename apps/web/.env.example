# =============================================================================
# CommitAI web app — environment
# Copy to `apps/web/.env` (gitignored) and fill in. Never commit real secrets.
# =============================================================================

# PostgreSQL connection string used by Prisma (datasource `db` in
# prisma/schema.prisma).
#
# Offline Prisma commands work with any syntactically valid URL:
#   pnpm --filter web exec prisma validate
#   pnpm --filter web exec prisma generate
#   pnpm --filter web exec prisma migrate diff \
#     --from-empty --to-schema-datamodel prisma/schema.prisma --script
#
# APPLYING migrations (`prisma migrate deploy`) and the DB-gated integration
# tests need a REACHABLE Postgres: a local install, a managed instance, or a
# container. When DATABASE_URL is unset/unreachable those tests skip cleanly
# (see LIMITATIONS.md step 3); the unit tests never need a DB.
DATABASE_URL="postgresql://user:password@localhost:5432/commitai?schema=public"

# -----------------------------------------------------------------------------
# Gemini (Google) — the AI provider (build steps 4–6).
# -----------------------------------------------------------------------------
# API key for the model. Get a free-tier key at https://aistudio.google.com/apikey
# The provider makes NO network call without this; when it is unset the AI unit
# tests use an in-test double and the live end-to-end test skips cleanly (see
# LIMITATIONS.md §8). This is the MODEL api key only — never a wallet/deployer key
# (CLAUDE.md rule 3).
#
# PRIVACY CAVEAT: on Google's FREE tier, prompts and responses may be used to
# improve Google's products. CommitAI is privacy-focused (raw evidence is stored
# off-chain, only hashes go on-chain — §9/§10), so a production deployment should
# use a paid tier (data not used for training) or self-hosted inference, and must
# never send raw evidence bytes to the model. See LIMITATIONS.md §10.
GEMINI_API_KEY=""

# Model id. Defaults to the current free-tier Flash model when unset. Override to
# pin a version or use the auto-updating `gemini-flash-latest` alias. The default
# is confirmed at build time per build-prompt §1.
GEMINI_MODEL="gemini-3.7-flash"
